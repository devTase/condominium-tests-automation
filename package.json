{
  "name": "condominium-tests-automation",
  "version": "1.0.0",
  "description": "Playwright Integration Tests for COndominiuum repo",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:debug": "cross-env PWDEBUG=1 playwright test",
    "codegen": "playwright codegen",
    "codegen:headed": "playwright codegen --device='Desktop Chrome'",
    "services:start": "node ./scripts/start-services.js",
    "lint": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devTase/condominium-tests-automation.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/devTase/condominium-tests-automation/issues"
  },
  "homepage": "https://github.com/devTase/condominium-tests-automation#readme",
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "wait-on": "^9.0.1"
  }
}
